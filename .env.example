# Supabase Auth + Data API. No PostgreSQL connection string is needed on Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (sb_secret_...). Never prefix with NEXT_PUBLIC_ or commit it.
SUPABASE_SECRET_KEY=
APP_URL=http://127.0.0.1:3000
# 64 hexadecimal characters. Generate with npm run setup:env; never commit actual values.
STORAGE_KEY=
# Use "supabase" on Vercel. The app creates a private bucket on first upload.
STORAGE_DRIVER=supabase
# Optional legacy local/Prisma development only:
DATABASE_URL=
DIRECT_URL=
STORAGE_DIR=.local/storage
BLOB_READ_WRITE_TOKEN=
DEMO_PASSWORD=
# Legacy local/Prisma recovery email only; Supabase Auth sends its own emails.
MAIL_TRANSPORT=local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Psicomatch <no-reply@example.com>
