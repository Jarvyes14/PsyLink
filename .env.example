DATABASE_URL=postgresql://psylink:CHANGE_ME@127.0.0.1:5433/psylink?schema=public
APP_URL=http://127.0.0.1:3000
# Generate with npm run setup:env; never commit actual values.
STORAGE_KEY=
STORAGE_DIR=.local/storage
DEMO_PASSWORD=
# Local delivery writes recovery emails under .local/mail; production requires SMTP.
MAIL_TRANSPORT=local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=PsyLink <no-reply@example.com>
