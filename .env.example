DATABASE_URL=postgresql://psylink:CHANGE_ME@127.0.0.1:5433/psylink?schema=public
# Vercel + Supabase: DATABASE_URL = Transaction pooler (:6543) with ?pgbouncer=true&connection_limit=1.
# DIRECT_URL = Session pooler (:5432), used only by Prisma CLI migrations.
# Copy both exact hosts/usernames from Supabase > Connect; URL-encode the password.
DIRECT_URL=
APP_URL=http://127.0.0.1:3000
# Generate with npm run setup:env; never commit actual values.
STORAGE_KEY=
STORAGE_DRIVER=local
STORAGE_DIR=.local/storage
# In Vercel use STORAGE_DRIVER=vercel-blob. Connecting a private Blob store adds this automatically.
BLOB_READ_WRITE_TOKEN=
DEMO_PASSWORD=
# Local delivery writes recovery emails under .local/mail; production requires SMTP.
MAIL_TRANSPORT=local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Psicomatch <no-reply@example.com>
